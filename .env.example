# Local development example
PORT=8770
DOTNET_VERSION=10.0

# Legacy single-root configuration.
# Use PROJECTS_ROOT for host paths, including Windows paths when running via Docker/WSL.
PROJECTS_ROOT=/home/user/projects

# Optional runtime/container root override used by existing project lookup.
# Docker compose sets this to /projects for the bind-mounted PROJECTS_ROOT.
# PROJECTS_ROOT_CONTAINER=/projects

# Canonical multi-root configuration for future Project Intelligence features.
# Must be a JSON array, not a delimiter-separated path list.
# PROJECTS_ROOTS=[{"id":"personal","path":"/home/user/projects","writableRegistry":true},{"id":"work","path":"/work/projects","writableRegistry":false}]

# Optional data directory override. Defaults to <repo>/data.
# DATA_DIR=/path/to/project-map-data
